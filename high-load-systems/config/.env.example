# Copy to config/.env for host-based runs. The Docker Compose stack injects these
# values directly, so a .env file is not required when running via `docker compose`.

APP_ENV=development
LOG_LEVEL=INFO

# Identifies which backend instance served a request (X-Instance-ID response header).
# Leave empty to fall back to the container hostname — that is what the Compose stack
# relies on when scaling with `--scale api=N` (Labs 2-3).
INSTANCE_ID=

# Host port 5434: 5432 and 5433 are already taken on the development machine.
# Inside the Compose network the host is `postgres` and the port is 5432.
DATABASE_URL=postgresql+asyncpg://cdn:cdn@localhost:5434/cdn_control_plane

# Connection pool sizing. Total server-side connections = DB_POOL_SIZE + DB_MAX_OVERFLOW
# multiplied by the number of API instances — keep that product below PostgreSQL's
# max_connections (default 100). This is the primary Lab 5 tuning knob.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_ECHO=false

# Fleet health thresholds used by routing eligibility.
# A node whose last heartbeat is older than this is treated as unreachable.
HEARTBEAT_STALE_AFTER_SECONDS=30
# Expected heartbeat interval advertised back to edge agents.
HEARTBEAT_INTERVAL_SECONDS=10
# At or above this load a node is auto-demoted to `degraded` and stops receiving traffic.
NODE_OVERLOAD_THRESHOLD_PERCENT=85

# Routing response shaping.
ROUTING_DEFAULT_CANDIDATES=3
ROUTING_MAX_CANDIDATES=10

# Lab3 — deliberate latency injection for the Round Robin vs Least Connections experiment.
# Set on exactly one instance of the pool; /health* is never delayed, so the slow node stays
# in the upstream pool and the run measures latency rather than failover.
# FAULT_DELAY_MS sleeps: holds a connection and a worker slot, burns no CPU (slow dependency).
# FAULT_CPU_SPIN_MS busy-loops: blocks the event loop and burns CPU (saturated node).
FAULT_DELAY_MS=0
FAULT_CPU_SPIN_MS=0

# Lab4 — distributed cache (Redis). Off by default: a cache is provisioned infrastructure, and
# an instance with no Redis on its network must not pretend to have one. The Compose stack
# sets CACHE_ENABLED=true; host runs and pytest stay on NullCache, which is also why CI needs
# no Redis service.
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
# Equal to HEARTBEAT_INTERVAL_SECONDS on purpose: a cached route embeds heartbeat-derived
# eligibility and load, so its staleness must not outlive one telemetry cycle. The asset's own
# cache_ttl_seconds caps it further when that is smaller.
CACHE_ROUTE_TTL_SECONDS=10
CACHE_STATS_TTL_SECONDS=30
# Shortens each TTL by up to this much, never lengthens it: keys written together must not
# expire together (cache avalanche).
CACHE_TTL_JITTER_PERCENT=10
# ~100x a local Redis GET. A healthy cache never trips it; a dead one costs this once before
# the circuit breaker stops consulting Redis at all.
CACHE_SOCKET_TIMEOUT_SECONDS=0.25
CACHE_BREAKER_FAILURE_THRESHOLD=3
CACHE_BREAKER_COOLDOWN_SECONDS=10
