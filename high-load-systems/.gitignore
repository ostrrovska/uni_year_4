# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environments
.venv
venv/
env/
ENV/

# Ruff / mypy caches
.ruff_cache/
.mypy_cache/

# Logs
*.log

# Local environment configuration (the committed template is config/.env.example)
config/.env

# Load-test raw output (Lab 5) — summaries are committed, multi-MB raw dumps are not
load-tests/results/*.json
load-tests/results/*.csv

# Local working context (author/agent notes and assignment texts — not graded deliverables)
CONTEXT.md
docs/context/
docs/labs/

# Lab5 - PostgreSQL and docker-stats snapshots taken around each run. The committed record is
# the per-run summary under docs/loadtest/lab5/; these are the intermediate files the
# orchestrator diffs, and the k6 --out csv dumps behind them are tens of MB each.
load-tests/results/
